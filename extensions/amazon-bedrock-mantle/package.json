{
  "name": "@gabrielvfonseca/amazon-bedrock-mantle-provider",
  "version": "2026.7.2",
  "description": "Operator Amazon Bedrock Mantle provider plugin for OpenAI-compatible model routing.",
  "repository": {
    "type": "git",
    "url": "https://github.com/gabrielvfonseca/openclaw"
  },
  "type": "module",
  "dependencies": {
    "@anthropic-ai/sdk": "0.109.1",
    "@aws/bedrock-token-generator": "1.1.0"
  },
  "devDependencies": {
    "@gabrielvfonseca/openclaw/plugin-sdk": "workspace:*",
    "@operator/typescript-config": "workspace:*"
  },
  "@gabrielvfonseca/openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "npmSpec": "@gabrielvfonseca/amazon-bedrock-mantle-provider",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.5.12-beta.1"
    },
    "compat": {
      "pluginApi": ">=2026.7.2"
    },
    "build": {
      "operatorVersion": "2026.7.2",
      "bundledDist": false
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}
