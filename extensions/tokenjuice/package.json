{
  "name": "@gabrielvfonseca/tokenjuice",
  "version": "2026.7.2",
  "description": "Operator tokenjuice exec output compaction plugin",
  "repository": {
    "type": "git",
    "url": "https://github.com/gabrielvfonseca/openclaw"
  },
  "type": "module",
  "dependencies": {
    "tokenjuice": "0.8.1"
  },
  "peerDependencies": {
    "@gabrielvfonseca/openclaw": ">=2026.7.2"
  },
  "peerDependenciesMeta": {
    "@gabrielvfonseca/openclaw": {
      "optional": true
    }
  },
  "devDependencies": {
    "@gabrielvfonseca/openclaw/plugin-sdk": "workspace:*",
    "@gabrielvfonseca/openclaw": "workspace:*",
    "@operator/typescript-config": "workspace:*"
  },
  "@gabrielvfonseca/openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "clawhubSpec": "clawhub:@gabrielvfonseca/tokenjuice",
      "npmSpec": "@gabrielvfonseca/tokenjuice",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.5.28"
    },
    "compat": {
      "pluginApi": ">=2026.7.2"
    },
    "build": {
      "operatorVersion": "2026.7.2",
      "bundledDist": false
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}
