{
  "name": "@gabrielvfonseca/openshell-sandbox",
  "version": "2026.7.2",
  "description": "Operator sandbox backend for the NVIDIA OpenShell CLI with mirrored local workspaces and SSH command execution.",
  "repository": {
    "type": "git",
    "url": "https://github.com/gabrielvfonseca/openclaw"
  },
  "type": "module",
  "dependencies": {
    "p-limit": "7.3.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@gabrielvfonseca/openclaw/plugin-sdk": "workspace:*",
    "@operator/typescript-config": "workspace:*"
  },
  "@gabrielvfonseca/openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "npmSpec": "@gabrielvfonseca/openshell-sandbox",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.5.12-beta.1"
    },
    "compat": {
      "pluginApi": ">=2026.7.2"
    },
    "build": {
      "operatorVersion": "2026.7.2",
      "bundledDist": false
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}
